APP_ENV=local
APP_NAME=归音 API
APP_SECRET_KEY=change-this-before-shared-deployment
APP_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./guiyin.db
MEDIA_STORAGE_DIR=./data/media
MEDIA_MAX_BYTES=10485760
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# DeepSeek uses an OpenAI-compatible Chat Completions API. Leave the key empty
# to use the deterministic safe demo provider during local development.
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-flash-vision-exp
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.35
# Fill from the current provider pricing page when cost estimation is needed.
AI_INPUT_COST_PER_MILLION_USD=0
AI_OUTPUT_COST_PER_MILLION_USD=0
AI_DAILY_REQUEST_LIMIT=200
AI_DAILY_TOKEN_LIMIT=200000
AI_MIN_INTERVAL_SECONDS=1

# RAG vectorization. The offline fallback needs no key. For neural semantic
# embeddings, point this at a reviewed OpenAI-compatible embeddings endpoint.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_TIMEOUT_SECONDS=30

# Voice cloning/TTS uses a separate reviewed provider. device_tts keeps the
# complete consent/upload flow but lets the phone perform neutral speech.
VOICE_PROVIDER=device_tts
VOICE_WEBHOOK_URL=
VOICE_WEBHOOK_TOKEN=
VOICE_TIMEOUT_SECONDS=60
VOICE_MAX_TEXT_CHARS=500
# Direct Alibaba Cloud Model Studio integration. Set VOICE_PROVIDER=dashscope_qwen
# and provide a separate DashScope key to enable cloned speech. DeepSeek is text/
# vision inference only and cannot replace this speech service.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_VOICE_MODEL=qwen3-tts-vc-2026-01-22
KNOWLEDGE_MAX_BYTES=10485760

# SMS is a console/debug provider in local. Replace before pilot deployment.
SMS_PROVIDER=console
# Shared deployments can set SMS_PROVIDER=webhook and connect an audited
# Tencent Cloud/Aliyun SMS adapter through this small JSON webhook contract.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_TIMEOUT_SECONDS=10
SMS_MIN_INTERVAL_SECONDS=60
SMS_HOURLY_LIMIT=10
SMS_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_MINUTES=60
BACKGROUND_JOBS_ENABLED=true
REPORT_SCHEDULER_INTERVAL_SECONDS=3600
