APP_ENV=local
APP_NAME=归音 API
APP_SECRET_KEY=change-this-before-shared-deployment
APP_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./guiyin.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# OpenAI-compatible LLM. Leave AI_API_KEY empty to use the safe local demo provider.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30

# SMS is a console/debug provider in local. Replace before pilot deployment.
SMS_PROVIDER=console
SMS_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_MINUTES=60

